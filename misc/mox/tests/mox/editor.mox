(* Representative expressions showcased in the playground editor. *)
unit
> unit

let double = fun x => x + x in double 21
> int

match [unit] with [] => unit | x :: xs => x
> unit

let pair = (unit, unit) in let (x, y) = pair in x
> unit

match (left(unit) : (unit + empty)) with left(x) => x | right(y) => absurd y
> unit

let r = ref unit in !r
> unit

let rec_id = rec f x => x in rec_id unit
> unit
